# ─── DEPLOY MODE ─────────────────────────────────────────────────────────────
# compute | web | full (default full for local dev)
DEPLOY_MODE=full
SERVE_WEB=true
ENABLE_NEST_AUTH=true
ENABLE_SUPABASE_AUTH=true
ENABLE_STANDALONE_AUTH=true
REQUIRE_DATABASE=true
# Literal "true" makes TAVILY_API_KEY mandatory for required search turns.
# Literal "false" allows startup without Tavily and disables web search.
REQUIRE_WEB_SEARCH=false
# All values in this file are read at process startup; restart/redeploy after changes.

# ═══════════════════════════════════════════════════════════════════════════════
# PROFILE A — COMPUTE (SMS production)
# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOY_MODE=compute
# SERVE_WEB=false
# ENABLE_NEST_AUTH=true
# ENABLE_SUPABASE_AUTH=false
# ENABLE_STANDALONE_AUTH=false
# REQUIRE_DATABASE=false
# REQUIRE_WEB_SEARCH=true
# No DATABASE_URL, no PINECONE_API_KEY required
# REDIS_URL=redis://...   # optional — in-memory rate limits if omitted
# NEST_JWT_PUBLIC_KEY_URL=https://<sms-backend>/api/v1/auth/public-key
# CORS_ALLOW_ORIGINS=https://<sms-frontend-or-backend>

# ═══════════════════════════════════════════════════════════════════════════════
# PROFILE B — WEB DEMO (Supabase + legacy routes)
# ═══════════════════════════════════════════════════════════════════════════════
# DEPLOY_MODE=web
# SERVE_WEB=true
# ENABLE_NEST_AUTH=false
# ENABLE_SUPABASE_AUTH=true
# ENABLE_STANDALONE_AUTH=true
# REQUIRE_DATABASE=true
# DATABASE_URL=postgresql://...@db.<project>.supabase.co:5432/postgres?schema=student_copilot
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<supabase-jwt-secret-from-dashboard>
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=<anon-key>
# PINECONE_API_KEY=...   # optional for standalone notebook RAG testing

# ─── Postgres (student_copilot schema on unified Pedagic DB) ────────────────
# Local: postgresql://admin:admin123@localhost:5433/pedagic?schema=student_copilot
# Railway: use public *.proxy.rlwy.net — NOT *.railway.internal (separate project)
DATABASE_URL=postgresql://postgres:PASSWORD@kodama.proxy.rlwy.net:51001/railway?schema=student_copilot&sslmode=require

# Temporary: skip JWT signature verification (reads sub/role/schoolId from Bearer)
AUTH_DISABLED=false
# SMS_SCHOOL_ID=your-school-uuid

# Nest hub (optional — for JWT_PUBLIC_KEY fetch / future file broker)
NEST_API_URL=http://localhost:4000/api/v1
NEST_JWT_PUBLIC_KEY_URL=http://localhost:4000/api/v1/auth/public-key
JWT_SECRET=your_super_secure_jwt_secret_key_here_min_32_chars
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=Pedagic School Management
JWT_AUDIENCE=school-users

# Supabase (web demo auth — frontend + backend JWT verify)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<jwt-secret-from-supabase-settings>

# Legacy standalone auth (demo UI fallback when Supabase not configured)
# PEDAGIC_PROVISION_SECRET=shared-with-frontend-STUDENT_COPILOT_PEDAGIC_SYNC_SECRET
AUTO_INGEST_SERVICE_TOKEN=shared-with-pedagic_01

# ─── CORE SYSTEM ─────────────────────────────────────────────────────────────
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Shared generation controls for the selected provider.
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=90

PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=student-copilot
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Required for compute deployments unless REQUIRE_WEB_SEARCH=false.
TAVILY_API_KEY=your_tavily_api_key_here

REDIS_URL=redis://localhost:6379/0

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

JWT_EXPIRY_HOURS=24
ENFORCE_STRONG_JWT_SECRET=false

CONVERSATION_TTL_SECONDS=2592000
LEARNING_METHOD_TTL_SECONDS=31536000
ENROLLMENT_TTL_SECONDS=0
TEACHER_CONTENT_TTL_SECONDS=31536000

RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_AUTH=10/minute

AGENT_VERBOSE=false

# Embedding ingestion controls (restart/redeploy after changing).
EMBED_BATCH_SIZE=15
EMBED_BATCH_PAUSE_SEC=2
EMBED_MAX_RETRIES=4
